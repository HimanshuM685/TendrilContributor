# ── Tendril contributor agent ────────────────────────────────────────────────
# Copy to .env and fill in. Only TENDRIL_API_KEY is required; everything else
# has a working default.

# REQUIRED. Your contributor API key.
#   1. Open the Tendril web app and connect + sign in with your wallet.
#   2. Go to CONTRIBUTE → MINT API KEY.
#   3. Paste it here. It is shown once.
# The key is your whole identity as a contributor: the wallet that minted it owns
# this node and is where the earnings land. There is no private key, no payout
# address and no registry URL to configure.
TENDRIL_API_KEY=

# Human label + advertised price per HOUR (USD) for this node.
NODE_LABEL=my-laptop
PRICE_PER_HOUR_USD=1.0

# SSH sandbox image. Renters get a plain SSH shell (not Jupyter). Left as the
# default, it's built locally on first rent from ./sandbox-ssh.
SANDBOX_IMAGE=tendril-ssh-sandbox:latest
# Resource caps applied to the sandbox container.
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
# Set to "all" to pass GPUs through (requires nvidia-container-toolkit), else empty.
SANDBOX_GPUS=

# How the sandbox's SSH port is exposed publicly:
#   bore  → the container dials out to a reverse tunnel (default; works anywhere)
#   local → publish SSH to 127.0.0.1 (only when renter + contributor share a box)
# WHICH tunnel server is used is chosen by the registry, not configured here.
TUNNEL_MODE=bore

# How often to ping the registry to stay listed.
HEARTBEAT_INTERVAL_MS=10000

# Self-hosting the backend? Point the agent at it. Otherwise leave this unset and
# the agent uses the hosted registry.
# REGISTRY_URL=http://localhost:4000
